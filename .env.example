# Copy to .env and fill in. .env is gitignored.
OPENAI_API_KEY=
MAINTAINOPS_URL=http://localhost:8000
PORT=3001
# Optional model overrides
STT_MODEL=whisper-1
LLM_MODEL=gpt-4o-mini
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Free local mode: PROVIDER=local uses Ollama + faster-whisper + macOS say (no API key)
PROVIDER=openai
OLLAMA_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b
WHISPER_CMD=.venv/bin/python
LOCAL_WHISPER_MODEL=base.en
SAY_VOICE=Samantha
